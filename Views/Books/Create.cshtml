@model BookNest.Models.Book

@{
ViewData["Title"] = "Add Book";
}

<style>
    .add-book-page {
        background-color: #F1F8F1;
        min-height: 80vh;
        padding: 40px 0;
    }

    .add-book-card {
        max-width: 750px;
        margin: auto;
        padding: 32px;
        background-color: #FAFDF9;
        border: 1px solid #D1E5D0;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(49, 92, 58, 0.08);
    }

    .add-book-title {
        color: #315C3A;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .add-book-description {
        color: #617663;
        margin-bottom: 28px;
    }

    .form-label {
        color: #315C3A;
        font-weight: 600;
    }

    .form-control {
        background-color: #FFFFFF;
        color: #35483A;
        border: 1px solid #D1E5D0;
        border-radius: 9px;
        padding: 11px 13px;
    }

    .form-control:focus {
        border-color: #83B985;
        box-shadow: 0 0 0 0.2rem rgba(131, 185, 133, 0.2);
    }

    .save-book-btn {
        background-color: #A8D5A2;
        border: 1px solid #A8D5A2;
        color: #24452B;
        border-radius: 8px;
        padding: 11px 22px;
        font-weight: 600;
    }

    .save-book-btn:hover {
        background-color: #83B985;
        border-color: #83B985;
        color: white;
    }

    .cancel-book-btn {
        background-color: #FAFDF9;
        border: 1px solid #BBD8B8;
        color: #315C3A;
        border-radius: 8px;
        padding: 11px 22px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }

    .cancel-book-btn:hover {
        background-color: #DCEEDC;
        color: #315C3A;
    }

    .field-hint {
        color: #718473;
        font-size: 0.85rem;
        margin-top: 5px;
    }

    @@media (max-width: 576px) {
        .add-book-card {
            padding: 22px;
        }

        .add-book-title {
            font-size: 1.7rem;
        }
    }
</style>

<div class="add-book-page">
    <div class="container">
        <div class="add-book-card">


        <h1 class="add-book-title">Add New Book</h1>

        <p class="add-book-description">
            Add a new book to your BookNest library collection.
        </p>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Book Title</label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Enter the book title" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Author" class="form-label">Author</label>
                <input asp-for="Author"
                       class="form-control"
                       placeholder="Enter the author's name" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label">Category</label>
                <input asp-for="Category"
                       class="form-control"
                       placeholder="Fiction, Programming, Finance..." />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ISBN" class="form-label">ISBN</label>
                <input asp-for="ISBN"
                       class="form-control"
                       placeholder="Enter ISBN number" />
                <span asp-validation-for="ISBN" class="text-danger"></span>
                <div class="field-hint">ISBN is optional.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">Total Quantity</label>
                <input asp-for="Quantity"
                       class="form-control"
                       type="number"
                       min="0" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AvailableQuantity"
                       class="form-label">Available Quantity</label>
                <input asp-for="AvailableQuantity"
                       class="form-control"
                       type="number"
                       min="0" />
                <span asp-validation-for="AvailableQuantity"
                      class="text-danger"></span>
                <div class="field-hint">
                    Enter a value that does not exceed the total quantity.
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3 mt-4">
                <button type="submit" class="save-book-btn">
                    Save Book
                </button>

                <a asp-controller="Books"
                   asp-action="Manage"
                   class="cancel-book-btn">
                    Cancel
                </a>
            </div>

        </form>

    </div>
</div>


</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
