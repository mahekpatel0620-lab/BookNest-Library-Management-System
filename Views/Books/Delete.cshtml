@model BookNest.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<style>
    .delete-page {
        padding: 40px 15px;
    }

    .delete-card {
        max-width: 650px;
        margin: 0 auto;
        background-color: #FAFDF9;
        border: 1px solid #D1E5D0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(49, 92, 58, 0.09);
    }

    .delete-header {
        background-color: #DCEEDC;
        padding: 24px;
        border-bottom: 1px solid #D1E5D0;
    }

    .delete-header h2 {
        color: #315C3A;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .delete-header p {
        color: #54745A;
        margin-bottom: 0;
    }

    .delete-body {
        padding: 30px;
    }

    .warning-box {
        background-color: #FFF5E8;
        border: 1px solid #F0D5AC;
        border-radius: 10px;
        padding: 16px;
        color: #80551F;
        margin-bottom: 25px;
    }

    .book-details dt {
        color: #315C3A;
        font-weight: 600;
        padding-bottom: 12px;
    }

    .book-details dd {
        color: #35483A;
        padding-bottom: 12px;
        overflow-wrap: anywhere;
    }

    .btn-delete {
        background-color: #C94C4C;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 11px 20px;
        font-weight: 600;
    }

    .btn-delete:hover {
        background-color: #A93232;
        color: white;
    }

    .btn-cancel {
        background-color: #DCEEDC;
        color: #315C3A;
        border: 1px solid #A8D5A2;
        border-radius: 8px;
        padding: 10px 20px;
        text-decoration: none;
        font-weight: 600;
    }

    .btn-cancel:hover {
        background-color: #A8D5A2;
        color: #24452B;
    }
</style>

<div class="delete-page">
    <div class="delete-card">

        <div class="delete-header">
            <h2>Delete Book</h2>
            <p>Review the book details before confirming deletion.</p>
        </div>

        <div class="delete-body">

            <div class="warning-box">
                <strong>Warning!</strong>
                Are you sure you want to delete this book? This action cannot be undone.
            </div>

            <dl class="row book-details">

                <dt class="col-sm-4">Book Title</dt>
                <dd class="col-sm-8">@Model.Title</dd>

                <dt class="col-sm-4">Author</dt>
                <dd class="col-sm-8">@Model.Author</dd>

                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@Model.Category</dd>

                <dt class="col-sm-4">ISBN</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.ISBN) ? "Not provided" : Model.ISBN)
                </dd>

                <dt class="col-sm-4">Total Quantity</dt>
                <dd class="col-sm-8">@Model.Quantity</dd>

                <dt class="col-sm-4">Available Quantity</dt>
                <dd class="col-sm-8">@Model.AvailableQuantity</dd>

            </dl>

            <form asp-controller="Books"
                  asp-action="Delete"
                  asp-route-id="@Model.BookId"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="d-flex flex-wrap gap-2 mt-3">

                    <button type="submit" class="btn-delete">
                        Yes, Delete Book
                    </button>

                    <a asp-controller="Books"
                       asp-action="Manage"
                       class="btn-cancel">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>