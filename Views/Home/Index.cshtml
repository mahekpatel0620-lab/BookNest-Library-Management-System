@{
    ViewData["Title"] = "Home";
}

<style>
    .home-container {
        max-width: 1200px;
        margin: auto;
        padding: 35px 20px;
    }

    .hero {
        background: linear-gradient(135deg, #fff5eb, #f2ddca);
        padding: 75px 25px;
        border-radius: 20px;
        text-align: center;
        margin-bottom: 45px;
    }

    .hero h1 {
        color: #5c3525;
        font-size: clamp(2.2rem, 5vw, 4rem);
        font-weight: 700;
        margin-bottom: 20px;
    }

    .hero p {
        color: #765747;
        font-size: 19px;
        line-height: 1.7;
        max-width: 720px;
        margin: 0 auto 30px;
    }

    .section-title {
        text-align: center;
        color: #5c3525;
        font-weight: 700;
        margin-bottom: 30px;
    }

    .feature-card {
        height: 100%;
        background: #ffffff;
        border: 1px solid #ead8c9;
        border-radius: 16px;
        padding: 30px 22px;
        text-align: center;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(92, 53, 37, 0.12);
    }

    .feature-icon {
        font-size: 42px;
        margin-bottom: 15px;
    }

    .feature-card h3 {
        color: #5c3525;
        font-size: 23px;
        margin-bottom: 15px;
    }

    .feature-card p {
        color: #765747;
        min-height: 55px;
        line-height: 1.6;
    }

    .btn-booknest {
        display: inline-block;
        background: #5c3525;
        color: #ffffff;
        padding: 12px 24px;
        border-radius: 9px;
        text-decoration: none;
        border: 1px solid #5c3525;
        transition: 0.2s;
    }

    .btn-booknest:hover {
        background: #7a4b36;
        color: #ffffff;
    }

    .btn-outline-booknest {
        display: inline-block;
        background: transparent;
        color: #5c3525;
        padding: 12px 24px;
        border-radius: 9px;
        border: 1px solid #5c3525;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-outline-booknest:hover {
        background: #5c3525;
        color: #ffffff;
    }

    .quick-actions {
        background: #fff5eb;
        border-radius: 16px;
        padding: 35px 20px;
        text-align: center;
        margin-top: 45px;
    }

    @@media (max-width: 576px) {
        .hero {
            padding: 45px 18px;
        }

        .hero p {
            font-size: 16px;
        }

        .feature-card {
            padding: 25px 18px;
        }
    }
</style>

<div class="home-container">

    <!-- Hero Section -->
    <section class="hero">

        <h1>Welcome to BookNest 📚</h1>

        <p>
            Your personal library management system.
            Discover books, organize your collection,
            and manage library records in one convenient place.
        </p>

        <a asp-controller="Books"
           asp-action="Collection"
           class="btn-booknest mb-2">
            Explore Our Books
        </a>

        <a asp-controller="Books"
           asp-action="Create"
           class="btn-outline-booknest ms-2 mb-2">
            + Add New Book
        </a>

    </section>

    <!-- Features Section -->
    <section>

        <h2 class="section-title">Explore BookNest</h2>

        <div class="row g-4">

            <!-- Book Collection -->
            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">📖</div>

                    <h3>Book Collection</h3>

                    <p>
                        Browse your library collection and
                        view all book details in one place.
                    </p>

                    <a asp-controller="Books"
                       asp-action="Collection"
                       class="btn-booknest">
                        View Collection
                    </a>

                </div>

            </div>

            <!-- Add Books -->
            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">➕</div>

                    <h3>Add New Books</h3>

                    <p>
                        Add new books and enter their title,
                        author, category, and quantity.
                    </p>

                    <a asp-controller="Books"
                       asp-action="Create"
                       class="btn-booknest">
                        Add New Book
                    </a>

                </div>

            </div>

            <!-- Manage Books -->
            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">🗂️</div>

                    <h3>Manage Books</h3>

                    <p>
                        Edit existing book details or
                        delete records when necessary.
                    </p>

                    <a asp-controller="Books"
                       asp-action="Manage"
                       class="btn-booknest">
                        Manage Books
                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- Quick Actions -->
    <section class="quick-actions">

        <h2 class="section-title">Manage Your Library</h2>

        <p class="mb-4">
            Keep your book collection organized and up to date.
        </p>

        <a asp-controller="Books"
           asp-action="Manage"
           class="btn-booknest mb-2">
            Open Book Management
        </a>

        <a asp-controller="Home"
           asp-action="Privacy"
           class="btn-outline-booknest ms-2 mb-2">
            Privacy Policy
        </a>

    </section>

</div>